<%- include('../partials/header', { title: title }) %>

<main class="dashboard-page">
  <section class="dashboard-hero">
    <div>
      <p class="eyebrow">Your wallet</p>
      <h2>Welcome back</h2>
      <p>Manage your balance, add money, and pay bills securely.</p>
    </div>
    <div class="balance-card">
      <p>Current Balance</p>
      <h3 id="balance-value">₹ 0</h3>
    </div>
  </section>

  <section class="dashboard-grid">
    <div class="panel-card">
      <h3>Add Money</h3>
      <form id="add-money-form" class="auth-form compact">
        <label>
          Amount
          <input type="number" name="amount" min="1" required />
        </label>
        <label>
          MPIN
          <input type="password" name="mpin" maxlength="4" required />
        </label>
        <button class="btn btn-primary" type="submit">Add Money</button>
      </form>
      <div id="add-money-message" class="message"></div>
    </div>

    <div class="panel-card">
      <h3>Pay Bill</h3>
      <form id="pay-bill-form" class="auth-form compact">
        <label>
          Biller Name
          <input type="text" name="billerName" required />
        </label>
        <label>
          Amount
          <input type="number" name="amount" min="1" required />
        </label>
        <label>
          MPIN
          <input type="password" name="mpin" maxlength="4" required />
        </label>
        <button class="btn btn-primary" type="submit">Pay Bill</button>
      </form>
      <div id="pay-bill-message" class="message"></div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
